node_modules/

# Segredos reais (use server/.env.example como modelo)
.env

# server/db/estancia.db é versionado de propósito (a pedido do lojista): assim
# o repositório carrega o catálogo/preços/pedidos reais e uma hospedagem nova
# já sobe com os dados atuais. Os arquivos auxiliares do modo WAL (-shm/-wal)
# ficam fora — são estado temporário, sempre recriado pelo SQLite ao abrir
# o banco; o que importa já foi consolidado no .db antes do commit.
server/db/estancia.db-shm
server/db/estancia.db-wal

# Réplica local do Turso (embedded replica) — recriada e sincronizada a cada
# subida do servidor; nunca deve ser versionada.
server/db/replica.db
server/db/replica.db-*

server/server.log
