# Copie este arquivo para ".env" e preencha os valores reais antes de subir para produção.

# Porta em que o servidor Node vai rodar
PORT=3000

# Chave usada para assinar o cookie de sessão - troque por um valor aleatório e secreto
SESSION_SECRET=troque-por-uma-chave-bem-aleatoria

# Senha inicial do superadmin (bruno.salvagni@gmail.com), usada apenas na primeira execução
SUPERADMIN_SENHA_INICIAL=TrocarSenha@2026

# Access Token de PRODUÇÃO do Mercado Pago (conta da loja)
# Gerar em: https://www.mercadopago.com.br/developers/panel/app
# Sem essa variável o checkout online fica desativado (pedido cai como "combinar pagamento")
MERCADOPAGO_ACCESS_TOKEN=

# Ambiente
NODE_ENV=development

# E-mail transacional (código de confirmação de cadastro no primeiro acesso).
# Sem estas variáveis, o código aparece no console/log do servidor em vez de
# ser enviado por e-mail — dá para testar o cadastro sem configurar nada.
#
# Passo a passo com Gmail (gratuito):
#  1. Ative a verificação em duas etapas na conta Google que vai enviar os e-mails.
#  2. Crie uma "Senha de app" em https://myaccount.google.com/apppasswords
#  3. Preencha EMAIL_USER com o e-mail e EMAIL_PASS com a senha de app gerada
#     (não é a senha normal da conta).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Estância Salvarte <seu-email@gmail.com>
